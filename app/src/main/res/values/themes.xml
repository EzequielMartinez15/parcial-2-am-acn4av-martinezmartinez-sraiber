<resources>
    <!-- Paleta común: la pantalla conserva su aspecto oscuro en ambos modos. -->
    <style name="Platform.Theme.Marber" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Base.Theme.Marber" parent="Platform.Theme.Marber">
        <item name="colorPrimary">@color/marber_primary</item>
        <item name="colorOnPrimary">@color/marber_on_primary</item>
        <item name="colorSurface">@color/marber_surface</item>
        <item name="colorOnSurface">@color/marber_text_high</item>
        <item name="colorOnSurfaceVariant">@color/marber_text_medium</item>
        <item name="colorOutline">@color/marber_surface_alt</item>
        <item name="colorOnBackground">@color/marber_text_high</item>
        <item name="android:colorBackground">@color/marber_background</item>
        <item name="android:windowBackground">@color/marber_background</item>
        <item name="colorError">@color/marber_error</item>
        <item name="colorOnError">@color/marber_on_primary</item>
        <item name="android:textColorPrimary">@color/marber_text_high</item>
        <item name="android:textColorSecondary">@color/marber_text_medium</item>
        <item name="android:statusBarColor">@color/marber_background</item>
        <item name="android:navigationBarColor">@color/marber_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Marber" parent="Base.Theme.Marber" />

    <style name="ThemeOverlay.Marber.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/marber_surface</item>
        <item name="colorSurfaceContainerHigh">@color/marber_surface_alt</item>
        <item name="colorOnSurface">@color/marber_text_high</item>
        <item name="colorOnSurfaceVariant">@color/marber_text_medium</item>
        <item name="colorPrimary">@color/marber_primary</item>
        <item name="colorOutline">@color/marber_text_medium</item>
        <item name="android:textColorPrimary">@color/marber_text_high</item>
        <item name="android:textColorSecondary">@color/marber_text_medium</item>
        <item name="alertDialogStyle">@style/Widget.Marber.Dialog</item>
    </style>

    <style name="Widget.Marber.Dialog" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/marber_surface_alt</item>
    </style>

    <!-- Estilo compartido por los dos campos del formulario. -->
    <style name="Widget.Marber.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/marber_surface</item>
        <item name="boxStrokeWidth">@dimen/stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_width_focused</item>
        <item name="boxStrokeErrorColor">@color/marber_error</item>
        <item name="boxCornerRadiusTopStart">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/control_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/control_corner_radius</item>
        <item name="android:textColorHint">@color/marber_text_medium</item>
        <item name="hintTextColor">@color/marber_primary</item>
        <item name="errorTextColor">@color/marber_error</item>
        <item name="endIconTint">@color/marber_text_medium</item>
    </style>
</resources>
