<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MarberGlassButton"><!--Estilos para los botones-->

        <item name="android:textStyle">bold</item>

        <item name="android:textSize">16sp</item>

        <item name="android:minHeight">48dp</item>

        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>

        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>

    </style>
    <style name="Widget.Marber.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/marber_primary</item>
        <item name="android:textColor">@color/marber_text_high</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">#40FFFFFF</item>
    </style>
    <style name="Widget.Marber.Button.Quiet" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/marber_primary_light</item>
        <item name="iconTint">@color/marber_primary_light</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">#203DA5FF</item>
    </style>
    <style name="Widget.Marber.Button.Danger" parent="Widget.Marber.Button.Quiet">
        <item name="android:textColor">@color/marber_text_medium</item>
        <item name="iconTint">@color/marber_text_medium</item>
    </style>
    <style name="Widget.Marber.Button.Secondary" parent="Widget.Marber.Button.Primary">
        <item name="backgroundTint">@color/marber_surface_alt</item>
        <item name="android:textColor">@color/marber_text_high</item>
    </style>

    <!-- Agrupé los estilos de las celdas del perfil para no repetir atributos en el layout. -->
    <style name="Marber.Perfil.Celda" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/space_small</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/space_medium</item>
        <item name="android:background">@drawable/bg_perfil_celda</item>
    </style>
    <style name="Marber.Perfil.Valor" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/perfil_stat_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/marber_text_high</item>
    </style>
    <style name="Marber.Perfil.Etiqueta" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/footer_text_size</item>
        <item name="android:textColor">@color/marber_text_medium</item>
    </style>
    <style name="Marber.Perfil.Fila" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">@dimen/space_small</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/space_medium</item>
        <item name="android:background">@drawable/bg_perfil_celda</item>
    </style>
    <style name="Marber.Perfil.Detalle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_small</item>
        <item name="android:textSize">@dimen/input_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/marber_text_high</item>
    </style>
</resources>
