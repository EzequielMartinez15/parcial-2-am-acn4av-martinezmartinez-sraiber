<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/marber_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="16dp" android:paddingTop="8dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/brand_title" android:letterSpacing="0.18" android:textStyle="bold"
            android:textSize="12sp" android:textColor="@color/marber_primary_light" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_logout"
            style="@style/Widget.Marber.Button.Danger" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/salir_corto" />
    </LinearLayout>
    <TextView android:id="@+id/titulo_home" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:text="@string/titulo_entrenamiento"
        android:textSize="32sp" android:textStyle="bold" android:textColor="@color/marber_text_high" />
    <TextView android:id="@+id/h2_home" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginTop="8dp"
        android:text="@string/subtitulo_entrenamiento" android:textSize="14sp" android:textColor="@color/marber_text_medium" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/input_filtros"
        style="@style/Widget.Marber.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp" android:hint="@string/ordenar_rutinas" app:endIconMode="dropdown_menu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/menu_drop_filtros"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:inputType="none" android:paddingStart="16dp" android:paddingEnd="48dp" android:saveEnabled="false"
            android:singleLine="true" android:textSize="14sp" android:textColor="@color/marber_text_high"
            app:dropDownBackgroundTint="@color/marber_surface" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/home_vacio" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/home_sin_rutinas" android:textColor="@color/marber_text_medium" android:gravity="center"
        android:padding="24dp" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_rutinas"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="8dp" />
</LinearLayout>
