<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/detalle_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/marber_background">
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_volver" app:icon="@drawable/ic_back" app:iconSize="18dp" app:iconGravity="textStart"
        style="@style/Widget.Marber.Button.Quiet" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/volver_rutinas"
        android:textColor="@color/marber_primary_light" android:layout_marginStart="@dimen/space_small"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@+id/txtTituloRutina" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_medium" android:layout_marginEnd="@dimen/space_medium" android:textSize="32sp" android:textStyle="bold"
        android:textColor="@color/marber_text_high" app:layout_constraintTop_toBottomOf="@id/btn_volver"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/txtResumenRutina" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_medium" android:layout_marginEnd="@dimen/space_medium" android:layout_marginTop="@dimen/space_small"
        android:textColor="@color/marber_text_medium" android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloRutina"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvEjercicios" android:layout_width="0dp"
        android:layout_height="0dp" android:paddingStart="@dimen/space_medium" android:paddingEnd="@dimen/space_medium"
        android:paddingTop="@dimen/space_medium" android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/txtResumenRutina" app:layout_constraintBottom_toTopOf="@id/acciones_detalle"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/detalle_vacio" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="@string/detalle_sin_ejercicios" android:textColor="@color/marber_text_medium"
        android:gravity="center" android:padding="@dimen/space_large" android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rvEjercicios" app:layout_constraintBottom_toBottomOf="@id/rvEjercicios"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:id="@+id/acciones_detalle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_medium" android:background="@color/marber_background"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAgregarEjercicio" app:icon="@drawable/ic_add" app:iconSize="18dp" app:iconGravity="textStart" style="@style/Widget.Marber.Button.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/agregar_ejercicio" android:textStyle="bold"
             />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBorrarRutina" style="@style/Widget.Marber.Button.Danger"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="@dimen/space_small" android:text="@string/txt_borrar_rutina"
             />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
