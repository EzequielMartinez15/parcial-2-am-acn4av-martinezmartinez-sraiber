<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_large">

        <TextView
            android:id="@+id/txtEjercicioSeleccionado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/marber_text_high"
            android:textSize="16sp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campo_rutina"
            app:endIconMode="dropdown_menu"
            style="@style/Widget.Marber.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/elegir_rutina">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/input_rutina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/control_height"
                android:inputType="none"
                android:saveEnabled="false"
                android:singleLine="true"
                android:paddingStart="@dimen/space_medium"
                android:paddingEnd="@dimen/space_medium"
                android:textColor="@color/marber_text_high"
                app:dropDownBackgroundTint="@color/marber_surface"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campo_grupo_muscular"
            style="@style/Widget.Marber.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/grupo_muscular"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/input_grupo_muscular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/control_height"
                android:inputType="none"
                android:saveEnabled="false"
                android:singleLine="true"
                android:paddingStart="@dimen/space_medium"
                android:paddingEnd="@dimen/space_medium"
                android:textColor="@color/marber_text_high"
                app:dropDownBackgroundTint="@color/marber_surface"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campo_nombre_ejercicio"
            style="@style/Widget.Marber.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ejercicio_nombre"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/input_nombre_ejercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/control_height"
                android:inputType="none"
                android:saveEnabled="false"
                android:singleLine="true"
                android:paddingStart="@dimen/space_medium"
                android:paddingEnd="@dimen/space_medium"
                app:dropDownBackgroundTint="@color/marber_surface"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campo_series_ejercicio"
            style="@style/Widget.Marber.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:hint="@string/ejercicio_series">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_series_ejercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true"
                android:imeOptions="actionNext" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campo_repeticiones_ejercicio"
            style="@style/Widget.Marber.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:hint="@string/ejercicio_repeticiones">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_repeticiones_ejercicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:singleLine="true"
                android:imeOptions="actionDone" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/error_guardado_ejercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:text="@string/ejercicio_guardado_error"
            android:textColor="@color/marber_error"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>