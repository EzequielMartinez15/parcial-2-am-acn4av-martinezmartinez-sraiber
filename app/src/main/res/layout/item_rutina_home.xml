<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginBottom="20dp"
    app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/marber_surface"
    app:strokeColor="@color/marber_border" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingTop="20dp" android:paddingBottom="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
            android:text="@string/txt_rutina" android:textSize="11sp" android:letterSpacing="0.16"
            android:textColor="@color/marber_primary_light" android:textStyle="bold" />
        <TextView android:id="@+id/titulo_card_rutina" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="6dp"
            android:textSize="26sp" android:textStyle="bold" android:textColor="@color/marber_text_high" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="8dp">
            <TextView android:id="@+id/subtitulo1_card" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/marber_text_medium" />
            <TextView android:id="@+id/subtitulo2_card" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/marber_text_medium" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_ejercicios" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:paddingStart="12dp"
            android:paddingEnd="12dp" android:clipToPadding="false" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_detalle_rutina"
            style="@style/Widget.Marber.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="16dp"
            android:text="@string/ver_rutina" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_agregar_ejercicio" app:icon="@drawable/ic_add" app:iconSize="18dp" app:iconGravity="textStart"
            style="@style/Widget.Marber.Button.Quiet" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:text="@string/agregar_ejercicio" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
